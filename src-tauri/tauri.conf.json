{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ato",
  "version": "0.2.2-beta",
  "identifier": "com.cengizg.ato",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": [
      "../qmd/src/",
      "../qmd/package.json",
      "../qmd/node_modules/"
    ]
  }
}
