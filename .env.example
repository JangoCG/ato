# Apple Notarization Credentials
# Copy this file to .env and fill in your values

# Your Apple ID email
APPLE_ID=your-email@example.com

# App-specific password (generate at https://appleid.apple.com/account/manage -> App-Specific Passwords)
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Apple Team ID (find at https://developer.apple.com/account -> Membership Details)
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_SIGNING_IDENTITY=XXX